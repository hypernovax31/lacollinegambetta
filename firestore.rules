rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /* Règles existantes de Mission Nautilus — conservées pour que ce dépôt
       puisse partager son projet Firebase sans casser le jeu. */
    match /teams/{teamCode} {
      allow read: if true;
      allow write: if request.auth != null;

      match /matelots/{matelotCode} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /morseSession/{sessionId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /matelots/{matelotCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /game/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /* Réservations La Colline : l'authentification anonyme est exigée.
       La limite de capacité est appliquée par la transaction du client ;
       les règles empêchent au minimum les écritures totalement anonymes et
       les documents manifestement hors format. */
    match /reservationCapacity/{date} {
      allow read, write: if request.auth != null;
    }

    match /reservations/{reservationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1
        && request.resource.data.guests <= 10
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
