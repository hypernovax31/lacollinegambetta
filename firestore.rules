rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /* Paramètres de configuration (lecture autorisée, écriture réservée admin) */
    match /reservationSettings/{document} {
      allow read: if true;
      allow write: if false;
    }

    /* Registre de capacité journalier */
    match /reservationCapacity/{date} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    /* Fiches individuelles des réservations */
    match /reservations/{reservationId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
