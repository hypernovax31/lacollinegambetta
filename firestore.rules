rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /* Registre de capacité : une transaction du navigateur lit puis met à
       jour le document de la date. La session Firebase anonyme est requise. */
    match /reservationCapacity/{date} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1
        && request.resource.data.guests <= 10
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
