rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /* Les réservations passent exclusivement par la Cloud Function : elle
       utilise l'Admin SDK et applique la transaction de capacité. */
    match /reservations/{reservationId} {
      allow read, write: if false;
    }
    match /capacity/{date} {
      allow read, write: if false;
    }
  }
}
